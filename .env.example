NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Buat nilai acak yang panjang dan simpan hanya di environment server.
SESSION_SECRET=

# ─── Cost Safety & Resource Guards ──────────────────────────────────────────────
# Rate limits (per minute)
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_AUTH=120
RATE_LIMIT_LOGIN=5
RATE_LIMIT_SENSITIVE=10
RATE_LIMIT_QR_SCAN=30
RATE_LIMIT_SYSTEM_MONITORING=30

# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Upload
MAX_UPLOAD_SIZE_MB=5

# Retry policy
MAX_RETRY=3

# Set 1 to disable per-request metrics DB write (hemat query & storage)
DISABLE_REQUEST_METRICS=0

# ─── Cost Guard Extra Protection Layer ───────────────────────────────────────
# Aktifkan seluruh fitur Cost Guard (1 = aktif, 0 = nonaktif total)
COST_GUARD_ENABLED=1

# Emergency Mode: 1 = batasi fitur non-kritis (monitoring, export, auto-mark,
# audit query berat) untuk hemat resource; fitur login/session/QR/absensi TETAP
# berjalan.
COST_GUARD_EMERGENCY_MODE=0

# Global request threshold (per window): status warning jika mendekati angka ini
# (tidak memblokir langsung, hanya flagging + trigger mode protected)
COST_GUARD_REQUEST_LIMIT=1000
COST_GUARD_WINDOW_SECONDS=60

# Endpoint heavy: jumlah request per menit maksimal
COST_GUARD_HEAVY_REQUESTS_PER_MINUTE=10

# Export safety: jumlah row maksimal & rentang tanggal maksimal (hari)
COST_GUARD_EXPORT_MAX_ROWS=5000
COST_GUARD_EXPORT_MAX_DATE_RANGE_DAYS=90

# Bulk insert: jumlah row maksimal per request
COST_GUARD_BULK_MAX_ROWS=200

# Circuit Breaker: berapa kali gagal berturut-turut sebelum cooldown aktif
COST_GUARD_FAILURE_THRESHOLD=10
# Durasi cooldown (detik) setelah threshold tercapai
COST_GUARD_COOLDOWN_SECONDS=60

# Slow query sampling: hanya log query di atas threshold ini (detik x 1000)
SLOW_QUERY_THRESHOLD_MS=1000
# Berapa persen query lambat yang dicatat (0.2 = 20%)
SLOW_QUERY_SAMPLE_RATE=0.2

# Response hard cap: potong response items jika melebihi jumlah ini (best effort)
MAX_RESPONSE_ITEMS=2000

# Cron Guard: batas maksimal overlap detik (anggap lock jadul expire jika > angka ini)
COST_GUARD_CRON_OVERLAP_SECONDS=600
